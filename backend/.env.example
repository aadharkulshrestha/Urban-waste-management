# Database connection (Railway MongoDB or MongoDB Atlas)
MONGO_URL=mongodb://localhost:27017/cleancitydatabase
DB_NAME=cleancitydatabase

# Security
JWT_SECRET=replace_with_a_secure_random_secret_in_production

# CORS (comma-separated list of origins, or * for all)
CORS_ORIGINS=*

# Port (assigned automatically by Railway)
PORT=8001

# Optional Hardware/Webcam URL (leave empty in cloud to use simulated camera)
# CAMERA_URL=http://192.168.137.142:8080/shot.jpg
